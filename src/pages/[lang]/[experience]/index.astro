---
import PageLayout from '@layouts/PageLayout.astro';
import TimelineSection from './_sections/TimelineSection.astro';
import EducationSection from './_sections/EducationSection.astro';
import { alternates, assertLocale, localeRouteParams, useTranslations } from '@i18n/utils';
import { seo } from '@data/profile';

export function getStaticPaths() {
  return localeRouteParams('experience');
}

const lang = assertLocale(Astro.params.lang);
const t = useTranslations(lang);
---

<PageLayout
  lang={lang}
  title={t('Trayectoria profesional')}
  description={seo.experience[lang]}
  alternates={alternates('experience')}
  current="experience"
>
  <TimelineSection lang={lang} />
  <EducationSection lang={lang} />
</PageLayout>
