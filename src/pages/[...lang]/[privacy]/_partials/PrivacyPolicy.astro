---
import Heading from '@velezanthony/design/components/atoms/display/Heading.astro';
import Link from '@velezanthony/design/components/atoms/actions/Link.astro';
import type { ResolvedSection } from '@core/privacy/resolve';
import type { IsoDate } from '@core/types';
import { formatDate } from '@core/i18n/format';
import { useTranslations } from '@ui/translations';
import type { Locale } from '@core/i18n/locales';

interface Props {
  lang: Locale;
  sections: ResolvedSection[];
  updated: IsoDate;
}

const { lang, sections, updated } = Astro.props;
const t = useTranslations(lang);
---

<article class="pt-14 pb-20 lg:pt-20">
  <p class="label mb-5 text-faint">{t('Privacidad')}</p>

  <Heading level={1} size="xl">
    {t('Política de privacidad')}
  </Heading>

  <p class="mt-4 text-sm text-faint">
    {t('Última actualización')}: <time datetime={updated}>{formatDate(lang, updated)}</time>
  </p>

  <!-- No sidebar beside it, so the text takes the page's width, as the header and footer do;
       the cookie table then fits without scrolling. -->
  <div class="prose mt-10 md:[--container-measure:none]">
    {sections.map((section) => (
      <>
        <h2 id={section.id}>{section.title}</h2>

        {section.blocks.map((block) => {
          if (block.kind === 'text') return <p>{block.text}</p>;

          if (block.kind === 'list') {
            return (
              <ul>
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            );
          }

          if (block.kind === 'links') {
            return (
              <ul class="list-none! pl-0!">
                {block.items.map((item) => (
                  <li>
                    <Link href={item.href}>{item.label}</Link>
                  </li>
                ))}
              </ul>
            );
          }

          return (
            <div class="table-scroll">
              <table>
                <caption class="sr-only">{block.caption}</caption>
                <thead>
                  <tr>
                    {block.head.map((cell) => (
                      <th scope="col">{cell}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {block.rows.map(([name, ...cells]) => (
                    <tr>
                      {/* Free text in a cell that is nowrap by default would stretch the table. */}
                      <th scope="row" class="min-w-28 align-top whitespace-normal!">
                        {name}
                      </th>
                      {cells.map((cell) => (
                        <td class="min-w-40 align-top">{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
        })}
      </>
    ))}
  </div>
</article>
