---
import Heading from '@velezanthony/design/components/atoms/display/Heading.astro';
import ContactList from '@ui/components/ContactList.astro';
import Timeline from '@ui/components/Timeline.astro';
import { cvContact, profile, spokenLanguages, stackGroups } from '@data/profile';
import { segments } from '@data/emphasis';
import { education } from '@data/education';
import { useTranslations } from '@ui/translations';
import { experience } from '@data/experience';
import type { Locale } from '@core/i18n/locales';
import DownloadCount from '@ui/components/DownloadCount.astro';
import type { DownloadSources, StoreCounts } from '@core/downloads/counts';

interface Props {
  lang: Locale;
  tools: {
    name: string;
    cvLine: string;
    /** The write-up on the public site, absolute: a CV printed locally must not link to localhost. */
    href: string;
    /** The stores it is published to, each linked to its page there. */
    packages: { label: string; href: string }[];
    downloads?: DownloadSources;
    downloadCounts?: StoreCounts;
  }[];
}

const { lang, tools } = Astro.props;
const t = useTranslations(lang);
---

<header class="flex items-start gap-5 border-b-2 border-ink pb-4">
  <img
    src={profile.photo}
    alt=""
    width="252"
    height="278"
    class="mt-0.5 hidden shrink-0 rounded-md object-cover sm:block"
    style="width: 26mm; height: 29mm"
  />

  <div class="min-w-0 flex-1">
    <Heading level={1} size="none" class="text-cv-name font-bold uppercase">
      {profile.name}
    </Heading>

    <p class="text-cv-headline mt-1.5 font-medium text-muted">{profile.headline[lang]}</p>

    <div class="text-cv-meta mt-2 flex flex-col items-start gap-y-2 print:flex-row print:flex-wrap print:items-center print:gap-x-5 print:gap-y-0.5">
      <p class="font-mono text-faint">{profile.location}</p>
      <ContactList
        items={cvContact}
        direction="column"
        class="print:flex-row print:flex-wrap print:items-center"
      />
    </div>
  </div>
</header>

<section class="mt-5 break-inside-avoid">
  <h2 class="cv-head mb-3">{t('Perfil')}</h2>
  <p class="text-cv-body max-w-none text-muted">
    {segments(profile.summary[lang]).map((s) =>
      s.strong ? <strong class="font-semibold text-ink">{s.value}</strong> : s.value,
    )}
  </p>
</section>

<section class="mt-5 break-inside-avoid border-y border-rule bg-raised px-4 py-3">
  <h2 class="cv-head mb-3">{t('Stack técnico')}</h2>

  <dl class="text-cv-body space-y-1">
    {stackGroups.map((group) => (
      <div class="flex gap-3">
        <dt class="w-[30mm] shrink-0 font-medium text-ink">{group.label[lang]}</dt>
        <dd class="min-w-0 text-muted">{group.items}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="mt-5">
  <h2 class="cv-head mb-3">{t('Trayectoria profesional')}</h2>
  <Timeline lang={lang} jobs={experience} studies={education} variant="cv" />
</section>

<!-- Whole on one page: split, it read as two lists. Chrome split it despite break-inside: avoid;
     on paper it is an inline-block, one unbreakable box that moves whole to the next page. -->
<section class="mt-5 print:inline-block print:w-full print:align-top">
  <h2 class="cv-head mb-3">{t('Herramientas propias')}</h2>

  <ul class="border-b border-rule">
    {tools.map((tool) => (
      <li class="text-cv-body flex break-inside-avoid flex-wrap items-baseline justify-between gap-x-4 border-t border-rule py-1">
        {/* Links in the PDF too, unstyled on paper: the name opens the write-up, a store its page. */}
        <span>
          <a href={tool.href} class="font-mono font-medium text-ink hover:text-accent">
            {tool.name}
          </a>
          <span class="text-rule" aria-hidden="true">
            {' — '}
          </span>
          <span class="text-muted">{tool.cvLine}</span>
        </span>
        {tool.packages.length > 0 && (
          <span class="text-cv-meta shrink-0 text-faint">
            {tool.packages.map((store, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={store.href} class="hover:text-accent">
                  {store.label}
                </a>
              </>
            ))}
            {tool.downloads && (
              <DownloadCount
                sources={tool.downloads}
                counts={tool.downloadCounts ?? {}}
                lang={lang}
                variant="inline"
              />
            )}
          </span>
        )}
      </li>
    ))}
  </ul>
</section>

<section class="mt-5 grid gap-x-10 gap-y-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
  <div class="break-inside-avoid">
    <h2 class="cv-head mb-3">{t('Formación')}</h2>
    <ul class="border-b border-rule">
      {education.map((study) => (
        <li class="border-t border-rule py-2">
          <p class="text-cv-meta font-medium text-faint tabular-nums">
            {study.startYear} – {study.endYear}
          </p>
          <p class="text-cv-body mt-0.5 font-medium text-ink">{study.title[lang]}</p>
          <p class="text-cv-body text-muted">{study.school}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="break-inside-avoid">
    <h2 class="cv-head mb-3">{t('Idiomas')}</h2>
    <ul class="border-b border-rule">
      {spokenLanguages.map((language) => (
        <li class="flex items-baseline justify-between gap-4 border-t border-rule py-2">
          <span class="text-cv-body text-ink">{language.name[lang]}</span>
          <span class="text-cv-meta font-medium text-faint uppercase">{language.level[lang]}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
