---
import PrintLayout from '@layouts/PrintLayout.astro';
import CvDocument from './_sections/CvDocument.astro';
import { getProjects } from '@data/projects';
import { pageTitles, seo } from '@data/profile';
import { alternates, assertLocale, localeRouteParams } from '@i18n/utils';

export function getStaticPaths() {
  return localeRouteParams('cv');
}

const lang = assertLocale(Astro.params.lang);

const projects = await getProjects(lang);
const tools = projects.map(({ entry }) => ({
  name: entry.data.name,
  cvLine: entry.data.cvLine,
}));
---

<PrintLayout
  lang={lang}
  title={pageTitles.cv[lang]}
  description={seo.cv[lang]}
  alternates={alternates('cv')}
>
  <CvDocument lang={lang} tools={tools} />
</PrintLayout>
