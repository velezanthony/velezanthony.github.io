---
import Heading from '@atoms/Heading.astro';
import ContactList from '@molecules/ContactList.astro';
import Timeline from '@organisms/Timeline.astro';
import { contact, profile, spokenLanguages, stackGroups } from '@data/profile';
import { education } from '@data/education';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  tools: { name: string; tagline: string }[];
}

const { lang, tools } = Astro.props;
const t = useTranslations(lang);
---

<header class="flex items-start gap-5 border-b-2 border-ink pb-4">
  <img
    src={profile.photo}
    alt=""
    width="252"
    height="278"
    class="mt-0.5 hidden shrink-0 rounded-md object-cover sm:block"
    style="width: 26mm; height: 29mm"
  />

  <div class="min-w-0 flex-1">
    <Heading level={1} size="none" class="text-cv-name font-bold uppercase">
      {profile.name}
    </Heading>

    <p class="text-cv-headline mt-1.5 font-medium text-muted">{profile.headline[lang]}</p>

    <div class="text-cv-meta mt-2 flex flex-wrap items-center gap-x-5 gap-y-0.5">
      <p class="font-mono text-faint">{profile.location}</p>
      <ContactList items={contact} direction="row" />
    </div>
  </div>
</header>

<section class="mt-5 break-inside-avoid">
  <h2 class="cv-head mb-3">{t('Perfil')}</h2>
  <p class="text-cv-body max-w-none text-muted">{profile.summary[lang]}</p>
</section>

<section class="mt-5 break-inside-avoid border-y border-rule bg-raised px-4 py-3">
  <h2 class="cv-head mb-3">{t('Stack técnico')}</h2>

  <dl class="text-cv-body space-y-1">
    {
      stackGroups.map((group) => (
        <div class="flex gap-3">
          <dt class="w-[30mm] shrink-0 font-medium text-ink">{group.label[lang]}</dt>
          <dd class="min-w-0 text-muted">{group.items}</dd>
        </div>
      ))
    }
  </dl>
</section>

<section class="mt-5">
  <h2 class="cv-head mb-3">{t('Trayectoria profesional')}</h2>
  <Timeline lang={lang} variant="cv" />
</section>

<section class="mt-5">
  <h2 class="cv-head mb-3">{t('Herramientas propias')}</h2>

  <ul class="border-b border-rule">
    {
      tools.map((tool) => (
        <li class="text-cv-body break-inside-avoid border-t border-rule py-1">
          <span class="font-mono font-medium text-ink">{tool.name}</span>
          <span class="text-rule" aria-hidden="true">
            {' — '}
          </span>
          <span class="text-muted">{tool.tagline}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="mt-5 grid gap-x-10 gap-y-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
  <div class="break-inside-avoid">
    <h2 class="cv-head mb-3">{t('Formación')}</h2>
    <ul class="border-b border-rule">
      {
        education.map((study) => (
          <li class="border-t border-rule py-2">
            <p class="text-cv-meta font-medium text-faint tabular-nums">
              {study.startYear} – {study.endYear}
            </p>
            <p class="text-cv-body mt-0.5 font-medium text-ink">{study.title[lang]}</p>
            <p class="text-cv-body text-muted">{study.school}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="break-inside-avoid">
    <h2 class="cv-head mb-3">{t('Idiomas')}</h2>
    <ul class="border-b border-rule">
      {
        spokenLanguages.map((language) => (
          <li class="flex items-baseline justify-between gap-4 border-t border-rule py-2">
            <span class="text-cv-body text-ink">{language.name[lang]}</span>
            <span class="text-cv-meta font-medium text-faint uppercase">{language.level[lang]}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
