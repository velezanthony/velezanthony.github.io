---
import PageLayout from '@layouts/PageLayout.astro';
import HeroSection from './_sections/HeroSection.astro';
import NowSection from './_sections/NowSection.astro';
import TrackRecordSection from './_sections/TrackRecordSection.astro';
import { pageTitles, seo } from '@data/profile';
import { alternates, assertLocale, localeParams } from '@i18n/utils';

export const getStaticPaths = localeParams;

const lang = assertLocale(Astro.params.lang);
---

<PageLayout
  lang={lang}
  title={pageTitles.home[lang]}
  description={seo.home[lang]}
  alternates={alternates()}
  current="home"
>
  <HeroSection lang={lang} />
  <NowSection lang={lang} />
  <TrackRecordSection lang={lang} />
</PageLayout>
