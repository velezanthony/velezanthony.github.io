---
import PageLayout from '@/ui/layouts/PageLayout.astro';
import Hero from './_partials/Hero.astro';
import Now from './_partials/Now.astro';
import TrackRecord from './_partials/TrackRecord.astro';
import { pageTitles, seo } from '@/data/profile';
import { alternates, assertLocale, localeParams } from '@/core/i18n/utils';

export const getStaticPaths = localeParams;

const lang = assertLocale(Astro.params.lang);
---

<PageLayout
  lang={lang}
  title={pageTitles.home[lang]}
  description={seo.home[lang]}
  alternates={alternates()}
  current="home"
>
  <Hero lang={lang} />
  <Now lang={lang} />
  <TrackRecord lang={lang} />
</PageLayout>
