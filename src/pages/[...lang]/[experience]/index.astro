---
import PageLayout from '@/layouts/PageLayout.astro';
import Timeline from './_partials/Timeline.astro';
import Education from './_partials/Education.astro';
import { alternates, assertLocale, localeRouteParams } from '@/i18n/utils';
import { pageTitles, seo } from '@/data/profile';

export function getStaticPaths() {
  return localeRouteParams('experience');
}

const lang = assertLocale(Astro.params.lang);
---

<PageLayout
  lang={lang}
  title={pageTitles.experience[lang]}
  description={seo.experience[lang]}
  alternates={alternates('experience')}
  current="experience"
>
  <Timeline lang={lang} />
  <Education lang={lang} />
</PageLayout>
