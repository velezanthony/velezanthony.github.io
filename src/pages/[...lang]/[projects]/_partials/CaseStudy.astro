---
import Heading from '@velezanthony/design/components/atoms/display/Heading.astro';
import Text from '@velezanthony/design/components/atoms/display/Text.astro';
import Link from '@velezanthony/design/components/atoms/actions/Link.astro';
import Todo from './Todo.astro';
import Rule from './Rule.astro';
import StackRow from '@/ui/components/StackRow.astro';
import StatusChip from '@/ui/components/StatusChip.astro';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import type { ProjectStatus } from '@/adapters/project-schema';
import DownloadCount from '@/ui/components/DownloadCount.astro';
import TableOfContents from '@velezanthony/design/components/molecules/navigation/TableOfContents.astro';
import { designStrings } from '@/adapters/design';
import type { DownloadSources, StoreCounts } from '@/data/downloads';

interface Props {
  lang: Locale;
  name: string;
  tagline: string;
  status: ProjectStatus;
  /** The stores the project is published to; the count is read from them in the browser. */
  downloads?: DownloadSources;
  /** What the build read from those stores: shown until the browser refreshes it. */
  downloadCounts?: StoreCounts;
  role: string;
  stack: string[];
  /** What it is built FOR, as opposed to what it is built with. */
  targets: string[];
  /** Declared support range. */
  compat: string[];
  /** Tests, CI, licence, docs — the apparatus. */
  quality: string[];
  constraints: string[];
  links: { label: string; href: string }[];
  todo: string[];
  translationPending: boolean;
  backHref: string;
  /** The write-up's headings, for the index beside it. */
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  lang,
  name,
  tagline,
  status,
  role,
  downloads,
  downloadCounts = {},
  stack,
  targets,
  compat,
  quality,
  constraints,
  links,
  todo,
  translationPending,
  backHref,
  headings = [],
} = Astro.props;

const t = useTranslations(lang);
const sections = headings.filter((heading) => heading.depth === 2);
---

<article class="pt-12 pb-20 lg:pt-16">
  <Link href={backHref} variant="quiet" class="label">
    {t('Volver a proyectos')}
  </Link>

  <header class="mt-10">
    <p class="label mb-5 text-faint">{t('Caso de estudio')}</p>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <Heading level={1} size="xl" class="font-mono">
        {name}
      </Heading>
      <StatusChip status={status} lang={lang} />
    </div>

    <Text tone="ink" size="lead" class="mt-5 max-w-(--container-measure)">
      {tagline}
    </Text>
  </header>

  <Rule marked class="mt-10" />

  {translationPending && (
    <p class="mt-8 border-l-2 border-accent bg-accent-soft px-4 py-3 text-sm text-accent">
      {t('Esta página aún no está traducida. Se muestra la versión en castellano.')}
    </p>
  )}

  <div class="mt-12 grid gap-x-16 gap-y-12 grid-cols-1 md:grid-cols-[minmax(0,1fr)_var(--container-aside)]">
    <div class="min-w-0 lg:order-1">
      <!-- Beside the sidebar the write-up takes the whole column, past the site-wide reading
           measure: less scrolling on long write-ups, at about 95 characters a line. Alone in one
           column it keeps the measure. -->
      <div class="prose md:[--container-measure:none]">
        <slot />
      </div>

      {todo.length > 0 && (
        <section class="mt-16">
          <p class="label mb-4 text-faint">{t('Pendiente de escribir')}</p>
          {todo.map((item) => (
            <Todo what={item} />
          ))}
        </section>
      )}
    </div>

    <!-- Runs the article's full height, so the index at its foot can stick once the details above
         have scrolled away. -->
    <aside class="space-y-8 lg:order-2">
      <div>
        <p class="label mb-2 text-faint">{t('Rol')}</p>
        <p class="text-sm text-ink">{role}</p>
      </div>

      <DownloadCount sources={downloads} counts={downloadCounts} lang={lang} variant="field" />

      {stack.length > 0 && (
        <div>
          <p class="label mb-3 text-faint">{t('Stack')}</p>
          <StackRow items={stack} field />
        </div>
      )}

      {targets.length > 0 && (
        <div>
          <p class="label mb-3 text-faint">{t('Para')}</p>
          <StackRow items={targets} field />
        </div>
      )}

      {compat.length > 0 && (
        <div>
          <p class="label mb-3 text-faint">{t('Compatibilidad')}</p>
          <StackRow items={compat} field />
        </div>
      )}

      {quality.length > 0 && (
        <div>
          <p class="label mb-3 text-faint">{t('Calidad')}</p>
          <ul class="space-y-1.5">
            {quality.map((item) => (
              <li class="flex items-baseline gap-2 text-sm text-ink">
                <span class="mt-1.5 size-1.5 shrink-0 bg-state-live" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {constraints.length > 0 && (
        <div>
          <p class="label mb-3 text-faint">{t('Restricciones')}</p>
          <ul class="space-y-2.5">
            {constraints.map((constraint) => (
              <li class="border-l-2 border-rule pl-3 text-sm text-ink">{constraint}</li>
            ))}
          </ul>
        </div>
      )}

      {links.length > 0 && (
        <div>
          <p class="label mb-3 text-faint">{t('Enlaces')}</p>
          <ul class="space-y-2">
            {links.map((link) => (
              <li>
                <Link href={link.href} variant="value">
                  <span class="font-mono text-mono-list">{link.label}</span>
                </Link>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Sections only: with the sub-headings the index outgrows the screen and, sticky, cannot be scrolled. */}
      {/* Two sections are a page, not a document worth an index. */}
      {sections.length >= 3 && (
        <TableOfContents headings={sections} strings={designStrings(lang)} />
      )}
    </aside>
  </div>
</article>
