---
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import ProjectGrid from '@organisms/ProjectGrid.astro';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="pt-14 pb-20 lg:pt-20">
  <p class="label mb-5 text-faint">{t('Proyectos')}</p>

  <Heading level={1} size="xl">{t('Herramientas propias')}</Heading>

  <Text class="mt-3" measure>{t('Todo el código es abierto y con licencia MIT.')}</Text>

  <ProjectGrid lang={lang} headingLevel={2} class="mt-10" />
</section>
