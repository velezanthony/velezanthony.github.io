---
import PageLayout from '@layouts/PageLayout.astro';
import { pageTitles, seo } from '@data/profile';
import ProjectIndexSection from './_sections/ProjectIndexSection.astro';
import { alternates, assertLocale, localeRouteParams } from '@i18n/utils';

export function getStaticPaths() {
  return localeRouteParams('projects');
}

const lang = assertLocale(Astro.params.lang);
---

<PageLayout
  lang={lang}
  title={pageTitles.projects[lang]}
  description={seo.projects[lang]}
  alternates={alternates('projects')}
  current="projects"
>
  <ProjectIndexSection lang={lang} />
</PageLayout>
