---
import { render } from 'astro:content';
import { commitDate } from '@/seo/commit-date';
import { breadcrumb, softwareSourceCode, techArticle } from '@/seo/jsonld';
import PageLayout from '@layouts/PageLayout.astro';
import CaseStudySection from './_sections/CaseStudySection.astro';
import { getProject, getProjectSlugs } from '@data/projects';
import { buildCountsOf } from '@data/build-counts';
import { alternates, assertLocale, langParam, path } from '@i18n/utils';
import { locales, routes } from '@i18n/ui';

export async function getStaticPaths() {
  const slugs = await getProjectSlugs();
  return locales.flatMap((lang) =>
    slugs.map((slug) => ({
      params: { lang: langParam(lang), projects: routes.projects[lang], slug },
    })),
  );
}

const lang = assertLocale(Astro.params.lang);
const slug = Astro.params.slug!;

const project = await getProject(lang, slug);
if (!project) throw new Error(`No project content for slug: ${slug}`);

const { entry, translationPending } = project;
const { Content, headings } = await render(entry);

/* Read from git and not from a frontmatter field on purpose: a date somebody has to remember to
   bump is a date that stops being true, and a stale `dateModified` is worse than none. */
const dateModified = entry.filePath ? commitDate(entry.filePath) : undefined;
const downloadCounts = await buildCountsOf(entry.data.downloads);
const indexUrl = new URL(path(lang, 'projects'), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<PageLayout
  lang={lang}
  title={`${entry.data.name} · ${entry.data.headline}`}
  bareTitle
  description={entry.data.tagline}
  alternates={alternates('projects', slug)}
  current="projects"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(softwareSourceCode(entry.data, pageUrl, dateModified))}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(techArticle(entry.data, lang, pageUrl, dateModified))}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(
        breadcrumb([
          { name: routes.projects[lang], url: indexUrl },
          { name: entry.data.name, url: pageUrl },
        ]),
      )}
    />
  </Fragment>

  <CaseStudySection
    lang={lang}
    name={entry.data.name}
    tagline={entry.data.tagline}
    status={entry.data.status}
    downloads={entry.data.downloads}
    downloadCounts={downloadCounts}
    role={entry.data.role}
    stack={entry.data.stack}
    targets={entry.data.targets}
    compat={entry.data.compat}
    quality={entry.data.quality}
    constraints={entry.data.constraints}
    links={entry.data.links}
    todo={entry.data.todo}
    translationPending={translationPending}
    headings={headings}
    backHref={path(lang, 'projects')}
  >
    <Content />
  </CaseStudySection>
</PageLayout>
