---
import { render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import CaseStudySection from './_sections/CaseStudySection.astro';
import { getProject, getProjectSlugs } from '@data/projects';
import { alternates, assertLocale, langParam, path } from '@i18n/utils';
import { locales, routes } from '@i18n/ui';

export async function getStaticPaths() {
  const slugs = await getProjectSlugs();
  return locales.flatMap((lang) =>
    slugs.map((slug) => ({
      params: { lang: langParam(lang), projects: routes.projects[lang], slug },
    })),
  );
}

const lang = assertLocale(Astro.params.lang);
const slug = Astro.params.slug!;

const project = await getProject(lang, slug);
if (!project) throw new Error(`No project content for slug: ${slug}`);

const { entry, translationPending } = project;
const { Content } = await render(entry);
---

<PageLayout
  lang={lang}
  title={`${entry.data.name} · ${entry.data.headline}`}
  description={entry.data.tagline}
  alternates={alternates('projects', slug)}
  current="projects"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: entry.data.name,
        description: entry.data.tagline,
        codeRepository: entry.data.links.find((l) => /github\.com/.test(l.href))?.href,
        programmingLanguage: entry.data.stack,
        license: 'https://opensource.org/licenses/MIT',
        author: { '@id': new URL('/#anthony', Astro.site).href },
      })}
    />
  </Fragment>

  <CaseStudySection
    lang={lang}
    name={entry.data.name}
    tagline={entry.data.tagline}
    status={entry.data.status}
    role={entry.data.role}
    stack={entry.data.stack}
    targets={entry.data.targets}
    compat={entry.data.compat}
    quality={entry.data.quality}
    constraints={entry.data.constraints}
    links={entry.data.links}
    todo={entry.data.todo}
    translationPending={translationPending}
    backHref={path(lang, 'projects')}
  >
    <Content />
  </CaseStudySection>
</PageLayout>
