---
import BaseLayout from '@layouts/BaseLayout.astro';
import Heading from '@atoms/Heading.astro';
import Text from '@atoms/Text.astro';
import Link from '@atoms/Link.astro';
import ContactList from '@molecules/ContactList.astro';
import { contact } from '@data/profile';
import { defaultLocale, locales } from '@i18n/ui';
import { alternates, path, useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

/**
 * Lives at the root, outside `[lang]`, because GitHub Pages serves a
 * single `/404.html` for the whole site and cannot pick a locale.
 *
 * Both languages are rendered into the document. Spanish shows by
 * default; if `sessionStorage` says the reader was browsing in English —
 * written by the script in BaseLayout on every page — it swaps. With no
 * JavaScript, Spanish stays.
 */
const bloques = locales.map((locale: Locale) => {
  const t = useTranslations(locale);
  return {
    locale,
    t,
    destinos: [
      { label: t('Inicio'), href: path(locale), hint: t('Quién soy y qué construyo') },
      { label: t('Proyectos'), href: path(locale, 'projects'), hint: t('Cinco herramientas open source') },
      { label: t('Experiencia'), href: path(locale, 'experience'), hint: t('Dónde he trabajado y en qué') },
      { label: t('CV'), href: path(locale, 'cv'), hint: t('Para descargar o imprimir') },
    ],
  };
});

const td = useTranslations(defaultLocale);
---

<BaseLayout
  lang={defaultLocale}
  title={td('Página no encontrada')}
  description={td('La ruta que buscas no existe.')}
  alternates={alternates()}
  noindex
>
  <Fragment slot="head">
    <style is:inline>
      [data-locale='en'] [data-lang='es'],
      :root:not([data-locale='en']) [data-lang='en'] {
        display: none;
      }
    </style>
  </Fragment>

  <main
    id="main"
    class="mx-auto flex min-h-screen max-w-(--container-page) flex-col justify-center px-6 py-20 lg:px-10"
  >
    {
      bloques.map(({ locale, t, destinos }) => (
        <div data-lang={locale} lang={locale}>
          <div class="grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,var(--container-text))_minmax(0,1fr)]">
            <div>
              <p class="label mb-6 text-faint">404</p>

              <Heading level={1} size="xl">
                {t('Página no encontrada')}
              </Heading>

              <Text class="mt-4" measure>
                {t('La ruta que buscas no existe. Pero ya que estás aquí:')}
              </Text>

              <ul class="mt-10 border-b border-rule">
                {destinos.map(({ label, href, hint }) => (
                  <li class="group relative border-t border-rule py-4">
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                      <a
                        href={href}
                        class="font-medium text-ink transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                      >
                        {label}
                      </a>
                      <span class="text-sm text-faint">{hint}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex flex-col gap-8 lg:pt-1">
              <div>
                <p class="label mb-3 text-faint">{t('Contacto')}</p>
                <ContactList items={contact} direction="column" />
              </div>

              <div>
                <Link href={path(locale === 'es' ? 'en' : 'es')} variant="action">
                  {t('¿Prefieres inglés?')}
                </Link>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (sessionStorage.getItem('lang') !== 'en') return;
    document.documentElement.lang = 'en';
    document.documentElement.dataset.locale = 'en';
    document.title = 'Page not found | Anthony Velez Tapia';
  });
</script>
