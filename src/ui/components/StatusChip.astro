---
import Tag from '@velezanthony/design/components/atoms/display/Tag.astro';
import { useTranslations } from '@/i18n/utils';
import type { Locale, Phrase } from '@/i18n/ui';
import type { ProjectStatus } from '@/adapters/project-schema';

interface Props {
  status: ProjectStatus;
  lang: Locale;
}

const { status, lang } = Astro.props;
const t = useTranslations(lang);

const labels: Record<ProjectStatus, Phrase> = {
  maintained: 'Mantenido',
  experimental: 'Experimental',
  unreleased: 'Sin publicar',
};

const tones = {
  maintained: 'live',
  experimental: 'wip',
  unreleased: 'faint',
} as const;
---

<Tag tone={tones[status]} dot>
  {t(labels[status])}
</Tag>
