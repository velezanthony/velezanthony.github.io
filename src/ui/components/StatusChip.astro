---
import Tag from '@velezanthony/design/components/atoms/display/Tag.astro';
import { useTranslations } from '@/ui/translations';
import type { Locale } from '@/core/i18n/locales';
import type { Phrase } from '@/data/ui';
import type { ProjectStatus } from '@/core/projects/status';

interface Props {
  status: ProjectStatus;
  lang: Locale;
}

const { status, lang } = Astro.props;
const t = useTranslations(lang);

const labels: Record<ProjectStatus, Phrase> = {
  maintained: 'Mantenido',
  experimental: 'Experimental',
  unreleased: 'Sin publicar',
};

const tones = {
  maintained: 'live',
  experimental: 'wip',
  unreleased: 'faint',
} as const;
---

<Tag tone={tones[status]} dot>
  {t(labels[status])}
</Tag>
