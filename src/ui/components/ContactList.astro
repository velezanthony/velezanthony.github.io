---
import Icon from '@velezanthony/design/components/atoms/display/Icon.astro';
import type { ContactLink } from '@core/types';

interface Props {
  items: ContactLink[];
  /** `grid`: from `md`, two rows filled column by column, so the first two items share a column. */
  direction?: 'row' | 'column' | 'grid';
  /** `inherit` takes the size of the parent, e.g. the CV's meta size. */
  size?: 'sm' | 'inherit';
  class?: string;
}

const { items, direction = 'column', size = 'sm', class: className } = Astro.props;

const opensAway = (href: string) => /^https?:\/\//.test(href);
---

<ul
  class:list={[
    'gap-x-6 gap-y-3',
    {
      row: 'flex flex-row flex-wrap items-center',
      column: 'flex flex-col',
      grid: 'grid grid-cols-1 md:grid-cols-none md:grid-flow-col md:grid-rows-2 md:auto-cols-max',
    }[direction],
    className,
  ]}
>
  {items.map((item) => (
    <li>
      <a
        href={item.href}
        target={opensAway(item.href) ? '_blank' : undefined}
        rel={opensAway(item.href) ? 'noopener noreferrer' : undefined}
        class="inline-flex min-h-6 items-center gap-2.5 text-muted transition-colors hover:text-accent"
      >
        <Icon name={item.icon} size={15} class="shrink-0 text-faint" />
        <span class:list={['font-mono', size === 'sm' && 'text-sm']}>
          {item.handle ?? item.label}
        </span>
      </a>
    </li>
  ))}
</ul>
