---
import Fonts from '@velezanthony/design/fonts';
import LibraryBaseLayout from '@velezanthony/design/components/layouts/BaseLayout.astro';
import { pageHead, type PageHeadInput } from '@velezanthony/design/seo';
import type { PageSeo } from '@velezanthony/design/seo-schema';
import { designStrings, gtmId } from '@velezanthony/design/site';
import { path } from '@core/i18n/utils';
import { person } from '@core/seo/jsonld';
import type { Locale } from '@core/i18n/locales';
import { owner } from '@data/person';
import { PERSON_ID } from '@data/site';
import RememberLocale from './_partials/RememberLocale.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** The `seo` block of a Markdown page, or loose values (`titleSuffix`, `noindex`…). */
  seo?: PageSeo;
  /** Extra JSON-LD of this page, after the site's Person. */
  schema?: PageHeadInput['schema'];
  /** Every locale's URL for this page, for `hreflang`. */
  alternates: Record<Locale, string>;
  bodyClass?: string;
}

const { lang, title, description, seo, schema = [], alternates, bodyClass } = Astro.props;
const strings = designStrings(lang);
const { pathname } = Astro.url;
const noindex = seo?.noindex ?? false;

const head = await pageHead({
  title,
  seo: { ...seo, description: seo?.description ?? description },
  locale: lang,
  url: pathname,
  alternates,
  ogType: 'website',
  schema: [
    person(
      owner,
      { site: Astro.site!, personId: PERSON_ID },
      lang,
      new URL(pathname, Astro.site).href,
    ),
    ...schema,
  ],
});
---

<LibraryBaseLayout
  lang={lang}
  head={head}
  bodyClass={['min-h-screen bg-canvas antialiased', bodyClass].filter(Boolean).join(' ')}
  gtmId={gtmId}
  privacyUrl={path(lang, 'privacy')}
  strings={strings}
>
  <Fragment slot="head">
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Fonts />

    <slot name="head" />
  </Fragment>

  {
    /* Not on the 404 itself: served at arbitrary paths, it would read as Spanish and overwrite
       the value it is about to consume. */
    !noindex && <RememberLocale />
  }

  <a
    href="#main"
    class="label sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:border focus:border-rule focus:bg-canvas focus:px-3 focus:py-2 focus:text-ink"
  >
    {strings.skipToContent}
  </a>

  <slot />
</LibraryBaseLayout>
