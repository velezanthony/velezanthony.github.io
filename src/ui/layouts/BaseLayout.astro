---
import { Font } from 'astro:assets';
import LibraryBaseLayout from '@velezanthony/design/components/layouts/BaseLayout.astro';
import { path } from '@/core/i18n/utils';
import { useTranslations } from '@/ui/translations';
import type { Locale } from '@/core/i18n/locales';
import { gtmId } from '@velezanthony/design/site';
import { pageHead } from '@/core/seo/head';
import { owner } from '@/data/person';
import { PERSON_ID } from '@/site';
import RememberLocale from './_partials/RememberLocale.astro';

interface Props {
  lang: Locale;
  title: string;

  /** Skips the ` | Anthony Velez Tapia` suffix. Project pages carry their own
      two-part title and would otherwise overflow the SERP truncation point. */
  bareTitle?: boolean;
  description: string;
  /** Every locale's URL for this page, for `hreflang`. */
  alternates: Record<Locale, string>;
  /** Keeps a page out of search results — used by 404. */
  noindex?: boolean;
  bodyClass?: string;
}

const {
  lang,
  title,
  bareTitle = false,
  description,
  alternates,
  noindex = false,
  bodyClass,
} = Astro.props;
const t = useTranslations(lang);

const head = pageHead({
  lang,
  title,
  bareTitle,
  description,
  alternates,
  noindex,
  pathname: Astro.url.pathname,
  site: Astro.site!,
  personId: PERSON_ID,
  owner,
  generator: Astro.generator,
});
---

<LibraryBaseLayout
  lang={lang}
  head={head}
  bodyClass={['min-h-screen bg-canvas antialiased', bodyClass].filter(Boolean).join(' ')}
  gtmId={gtmId}
  privacyUrl={path(lang, 'privacy')}
  label={t('Aviso de cookies')}
  message={t('Uso cookies de analítica solo si las aceptas. La web funciona igual sin ellas.')}
  acceptLabel={t('Aceptar')}
  rejectLabel={t('Rechazar')}
  privacyLabel={t('Política de privacidad')}
>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />

    <slot name="head" />
  </Fragment>

  {
    /* Not on the 404 itself: served at arbitrary paths, it would read as Spanish and overwrite
       the value it is about to consume. */
    !noindex && <RememberLocale />
  }

  <a
    href="#main"
    class="label sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:border focus:border-rule focus:bg-canvas focus:px-3 focus:py-2 focus:text-ink"
  >
    {t('Ir al contenido')}
  </a>

  <slot />

  <Fragment slot="scripts">
    <script>
      import { trackSections } from '@velezanthony/design/client/toc';

      /* The case study's table of contents follows the section being read. */
      const toc = document.querySelector('nav.toc');
      if (toc) trackSections(toc);
    </script>
  </Fragment>
</LibraryBaseLayout>
