---
import ContactList from '@ui/components/ContactList.astro';
import CookieSettingsButton from '@velezanthony/design/components/atoms/actions/CookieSettingsButton.astro';
import Link from '@velezanthony/design/components/atoms/actions/Link.astro';
import type { ContactLink } from '@core/types';
import { LIBRARY_SOURCE, SITE_HOST, SITE_SOURCE } from '@data/site';
import { path } from '@core/i18n/utils';
import { designStrings } from '@velezanthony/design/site';
import { useTranslations } from '@ui/translations';
import type { Locale } from '@core/i18n/locales';

interface Props {
  lang: Locale;
  name: string;
  contact: ContactLink[];
  /** Of the copyright line. Passed in so the footer renders the same whenever it is rendered. */
  year: number;
  /** Whether the site asks for cookie consent, and so has a choice to reopen. */
  cookieControl?: boolean;
  /** Classes added to the `<footer>`'s own, for the layout that places it. */
  class?: string;
}

const { lang, name, contact, year, cookieControl = false, class: className } = Astro.props;
const t = useTranslations(lang);
---

{/* `surface-inverse` is the library's inverted surface: it redefines the tokens in its scope. */}
<footer class:list={['surface-inverse', className]}>
  <div class="mx-auto max-w-(--container-page) px-6 py-12 lg:px-10">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <p class="label mb-4 text-faint">{t('Contacto')}</p>
        <ContactList items={contact} />
      </div>

      <div class="space-y-8 md:justify-self-end md:text-right">
        <div>
          <p class="label mb-4 text-faint">{t('Código fuente')}</p>
          <Link href={SITE_SOURCE} variant="quiet">
            <span class="font-mono text-sm">{SITE_HOST}</span>
          </Link>
        </div>
        {/* The design library this site is built on. */}
        <div>
          <p class="label mb-4 text-faint">{t('Librería')}</p>
          <Link href={LIBRARY_SOURCE} variant="quiet">
            <span class="font-mono text-sm">@velezanthony/design</span>
          </Link>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-ink/20 pt-6 font-mono text-xs text-muted">
      <p>
        © {year} {name}
      </p>

      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <li>
          <Link href={path(lang, 'privacy')} variant="quiet">
            {t('Privacidad')}
          </Link>
        </li>
        {cookieControl && (
          <li>
            {/* The library's button, the one its own footer uses: the consent script listens to it. */}
            <CookieSettingsButton strings={designStrings(lang)} />
          </li>
        )}
        <li>
          <Link href={SITE_SOURCE} variant="quiet">
            {t('Portfolio hecho con Astro')}
          </Link>
        </li>
      </ul>
    </div>
  </div>
</footer>
