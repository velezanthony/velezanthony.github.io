---
import ContactList from '@molecules/ContactList.astro';
import Link from '@atoms/Link.astro';
import type { ContactLink } from '@data/types';
import { SITE_HOST, SITE_SOURCE } from '@/site';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  name: string;
  contact: ContactLink[];
  /** Of the copyright line. Passed in so the footer renders the same whenever it is rendered. */
  year: number;
}

const { lang, name, contact, year } = Astro.props;
const t = useTranslations(lang);
---

<footer class="border-t border-rule">
  <div class="mx-auto max-w-(--container-page) px-6 py-12 lg:px-10">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <p class="label mb-4 text-faint">{t('Contacto')}</p>
        <ContactList items={contact} />
      </div>

      <div class="md:justify-self-end md:text-right">
        <p class="label mb-4 text-faint">{t('Código fuente')}</p>
        <Link href={SITE_SOURCE} variant="quiet">
          <span class="font-mono text-sm">{SITE_HOST}</span>
        </Link>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-rule pt-6 font-mono text-xs text-faint">
      <p>
        © {year} {name}
      </p>

      <p>
        <Link href={SITE_SOURCE} variant="quiet">
          {t('Portfolio hecho con Astro')}
        </Link>
      </p>
    </div>
  </div>
</footer>
