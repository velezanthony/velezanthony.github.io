---
import ContactList from '@molecules/ContactList.astro';
import Link from '@velezanthony/design/components/atoms/actions/Link.astro';
import type { ContactLink } from '@data/types';
import { SITE_HOST, SITE_SOURCE } from '@/site';
import { path, useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  name: string;
  contact: ContactLink[];
  /** Of the copyright line. Passed in so the footer renders the same whenever it is rendered. */
  year: number;
  /** Whether the site asks for cookie consent, and so has a choice to reopen. */
  cookieControl?: boolean;
}

const { lang, name, contact, year, cookieControl = false } = Astro.props;
const t = useTranslations(lang);
---

{/* `surface-inverse` is the library's inverted surface: it redefines the tokens in its scope. */}
<footer class="surface-inverse">
  <div class="mx-auto max-w-(--container-page) px-6 py-12 lg:px-10">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <p class="label mb-4 text-faint">{t('Contacto')}</p>
        <ContactList items={contact} />
      </div>

      <div class="md:justify-self-end md:text-right">
        <p class="label mb-4 text-faint">{t('Código fuente')}</p>
        <Link href={SITE_SOURCE} variant="quiet">
          <span class="font-mono text-sm">{SITE_HOST}</span>
        </Link>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-ink/20 pt-6 font-mono text-xs text-muted">
      <p>
        © {year} {name}
      </p>

      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <li>
          <Link href={path(lang, 'privacy')} variant="quiet">
            {t('Privacidad')}
          </Link>
        </li>
        {cookieControl && (
          <li>
            {/* A button, not a link: it acts on the page, it goes nowhere. Tailwind's preflight
                sets `cursor: default` on buttons. */}
            <button
              type="button"
              data-consent-open
              class="inline-flex min-h-6 cursor-pointer items-center text-muted transition-colors hover:text-ink"
            >
              {t('Preferencias de cookies')}
            </button>
          </li>
        )}
        <li>
          <Link href={SITE_SOURCE} variant="quiet">
            {t('Portfolio hecho con Astro')}
          </Link>
        </li>
      </ul>
    </div>
  </div>
</footer>
