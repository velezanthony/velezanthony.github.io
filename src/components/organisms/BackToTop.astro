---
import Icon from '@atoms/Icon.astro';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

/**
 * `href="#top"` needs no target element and no script: the HTML spec
 * scrolls to the top of the document for that fragment.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<a href="#top" class="back-to-top print-hidden" aria-label={t('Volver arriba')}>
  <Icon name="arrow" size={16} />
</a>

<style>
  .back-to-top {
    position: fixed;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 40;

    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;

    border: 1px solid var(--color-rule);
    border-radius: 4px;
    background-color: var(--color-canvas);
    color: var(--color-muted);

    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .back-to-top:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .back-to-top :global(svg) {
    transform: rotate(-90deg);
  }

  @supports (animation-timeline: scroll()) {
    .back-to-top {
      opacity: 0;
      visibility: hidden;

      /* Longhands: the shorthand resets duration to 0s and a scroll-driven
         animation with zero duration never runs, leaving this hidden. */
      animation-name: back-to-top-in;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 90vh 140vh;
    }
  }

  @keyframes back-to-top-in {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
