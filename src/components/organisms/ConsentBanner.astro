---
import Link from '@atoms/Link.astro';
import { path, useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  /** The Tag Manager container to load once the visitor accepts. The script reads it from here. */
  gtmId: string;
}

const { lang, gtmId } = Astro.props;
const t = useTranslations(lang);

/* One class string for both: rejecting has to be as easy, and as visible, as accepting. */
const button =
  'label inline-flex min-h-10 cursor-pointer items-center justify-center border border-ink px-5 text-ink transition-colors hover:border-accent hover:text-accent';
---

<!-- Hidden until the script finds no stored choice. A region, not a dialog: it does not trap
     focus or block the page, it only asks. -->
<section
  data-consent-banner
  data-gtm-id={gtmId}
  aria-label={t('Aviso de cookies')}
  hidden
  class="consent-banner print-hidden border-t border-rule bg-canvas"
>
  <div class="mx-auto flex max-w-(--container-page) flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 py-4 lg:px-10">
    <p class="max-w-(--container-measure) text-sm text-muted">
      {t('Uso cookies de analítica solo si las aceptas. La web funciona igual sin ellas.')}{' '}
      <Link href={path(lang, 'privacy')}>{t('Política de privacidad')}</Link>
    </p>

    <div class="flex gap-3">
      <button type="button" data-consent-accept class={button}>
        {t('Aceptar')}
      </button>
      <button type="button" data-consent-reject class={button}>
        {t('Rechazar')}
      </button>
    </div>
  </div>
</section>

<style is:global>
  .consent-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* The script writes the banner's height here while it is showing, so the footer scrolls clear
     of it instead of sitting underneath. */
  body {
    padding-bottom: var(--consent-space, 0);
  }
</style>

<script>
  import { initConsent } from '@/client/consent';
  import { storageOf } from '@/client/storage';

  initConsent({
    doc: document,
    storage: storageOf('localStorage'),
    hostname: location.hostname,
    reload: () => location.reload(),
  });
</script>
