---
import ProjectCard from '@molecules/ProjectCard.astro';
import type { LocalisedProject } from '@data/projects';
import { path } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  projects: LocalisedProject[];
  /** Forwarded to each card. Depends on what precedes the grid. */
  headingLevel?: 2 | 3;
  /** Close the list with a rule. Off inside a band, whose own edge already is one. */
  closed?: boolean;
  class?: string;
}

const { lang, projects, headingLevel = 3, closed = true, class: className } = Astro.props;
---

<div class:list={[closed && 'border-b border-rule', className]}>
  {projects.map(({ entry }) => (
    <ProjectCard
      name={entry.data.name}
      tagline={entry.data.tagline}
      status={entry.data.status}
      stack={entry.data.stack}
      targets={entry.data.targets}
      href={path(lang, 'projects', entry.data.slug)}
      lang={lang}
      headingLevel={headingLevel}
    />
  ))}
</div>
