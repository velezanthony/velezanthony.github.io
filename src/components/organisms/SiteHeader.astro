---
import LocaleSwitch from '@molecules/LocaleSwitch.astro';
import ThemeToggle from '@molecules/ThemeToggle.astro';
import { path, useTranslations } from '@i18n/utils';
import type { Locale, Phrase, RouteKey } from '@i18n/ui';

interface Props {
  lang: Locale;
  /** The site's name, which is the person's. */
  name: string;
  alternates: Record<Locale, string>;
  /** Route key of the current page, used for `aria-current`. */
  current?: RouteKey | 'home';
}

const { lang, name, alternates, current } = Astro.props;
const t = useTranslations(lang);

const nav: { key: RouteKey; label: Phrase }[] = [
  { key: 'projects', label: 'Proyectos' },
  { key: 'experience', label: 'Experiencia' },
  { key: 'cv', label: 'CV' },
];
---

<header class="border-b border-rule">
  <!-- Two rows on a phone, one from md up. The name and the controls share the first row and the
       nav takes the whole second one: three links fit in view, so they are not hidden behind a
       menu, and the header stays free of JavaScript. Source order stays name, nav, controls, so
       Tab reaches the main navigation first at every width. -->
  <div class="mx-auto grid max-w-(--container-page) grid-cols-[1fr_auto] items-center gap-x-3 gap-y-2 px-6 py-4 md:grid-cols-[1fr_auto_auto] md:gap-x-8 md:py-5 lg:px-10">
    <a
      href={path(lang)}
      aria-current={current === 'home' ? 'page' : undefined}
      class="col-start-1 row-start-1 inline-flex min-h-6 items-center justify-self-start font-mono text-sm font-medium tracking-tight text-ink transition-colors hover:text-accent"
    >
      {name}
    </a>

    <nav
      aria-label={t('Navegación principal')}
      class="col-span-2 row-start-2 md:col-span-1 md:col-start-2 md:row-start-1"
    >
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
        {nav.map((item) => (
          <li>
            <a
              href={path(lang, item.key)}
              aria-current={current === item.key ? 'page' : undefined}
              class:list={[
                'label inline-flex min-h-6 min-w-6 items-center justify-center transition-colors hover:text-accent',
                current === item.key ? 'text-ink' : 'text-faint',
              ]}
            >
              {t(item.label)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col-start-2 row-start-1 flex items-center gap-1 border-rule md:col-start-3 md:border-l md:pl-5">
      <LocaleSwitch lang={lang} hrefs={alternates} />
      <ThemeToggle lang={lang} class="print-hidden" />
    </div>
  </div>
</header>
