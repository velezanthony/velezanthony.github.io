---
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{/*
  A run of short items separated by a middot, wrapped like prose — without the middot ever
  starting or ending a line.

  The separator is drawn before each item, so none can trail a line. The list is pulled left by
  one separator's width inside a clipping box, so the separator of whichever item starts a line
  falls outside the box and is cut off.

  Each item is a flex item: one that does not fit moves to the next line whole, so "VS Code API"
  does not split. Capped at the column, only an item wider than the whole column wraps inside —
  without the cap the clip would cut it off.
*/}
{items.length > 0 && (
  <div class:list={['inline-list', className]}>
    <ul>
      {items.map((item) => (
        <li class="max-w-full">{item}</li>
      ))}
    </ul>
  </div>
)}

<style>
  /* The separator's width, set by the caller's typeface: 1em suits sans; mono wants 3ch, the
     " · " it replaces. */
  .inline-list {
    overflow: hidden;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin-left: calc(-1 * var(--separator, 1em));
  }

  li {
    position: relative;
    padding-left: var(--separator, 1em);
  }

  li::before {
    /* Empty alternative text: a screen reader announces the list, not the dots. */
    content: '·' / '';
    position: absolute;
    left: 0;
    width: var(--separator, 1em);
    text-align: center;
    color: var(--color-rule);
  }
</style>
