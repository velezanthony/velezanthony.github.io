---
import Heading from '@atoms/Heading.astro';
import StackRow from '@molecules/StackRow.astro';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

type Variant = 'site' | 'cv';

interface Props {
  company: string;
  role: string;
  range: string;
  location?: string;
  highlights: string[];
  stack?: string[];
  lang: Locale;
  variant?: Variant;
  /** Set by the caller so the document outline never skips a level. */
  headingLevel?: 2 | 3;
}

const {
  company,
  role,
  range,
  location,
  highlights,
  stack = [],
  lang,
  variant = 'site',
  headingLevel = 3,
} = Astro.props;

const t = useTranslations(lang);
const cv = variant === 'cv';
---

<article class:list={['border-t border-rule', cv ? 'py-3' : 'py-6']}>
  {
    cv ? (
      <Fragment>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <Heading level={headingLevel} size="none" class="font-bold">
            {company}
          </Heading>
          <p class="text-cv-meta shrink-0 font-medium text-faint tabular-nums">{range}</p>
        </div>

        <p class="text-cv-role font-medium text-accent">
          {role}
          {location && (
            <span class="text-cv-meta font-normal text-faint">
              <span aria-hidden="true"> · </span>
              {location}
            </span>
          )}
        </p>

        <ul class="mt-2 space-y-1">
          {highlights.map((highlight) => (
            <li class="text-cv-body relative pl-5 text-muted before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-3 before:bg-rule before:content-['']">
              {highlight}
            </li>
          ))}
        </ul>

        <StackRow items={stack} label={t('Stack')} size="cv" class="mt-2" />
      </Fragment>
    ) : (
      <div class="grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,var(--container-text))_minmax(0,1fr)]">
        <div>
          <Heading level={headingLevel} size="md">
            {company}
          </Heading>

          <p class="mt-1 font-medium text-accent">{role}</p>

          <p class="label mt-2 text-faint tabular-nums lg:hidden">
            {range}
            {location && <span class="ml-3 normal-case">{location}</span>}
          </p>

          <ul class="mt-3 space-y-1.5">
            {highlights.map((highlight) => (
              <li class="text-row relative max-w-(--container-measure) pl-5 text-muted before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-3 before:bg-rule before:content-['']">
                {highlight}
              </li>
            ))}
          </ul>
        </div>

        <div class="min-w-0 lg:pt-1.5">
          <p class="label hidden text-faint tabular-nums lg:block">{range}</p>
          {location && <p class="mt-1.5 hidden text-sm text-faint lg:block">{location}</p>}
          <StackRow items={stack} label={t('Stack')} size="site" class="mt-4" stacked />
        </div>
      </div>
    )
  }
</article>
