---
import { locales, localeNames } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  hrefs: Record<Locale, string>;
  class?: string;
}

const { lang, hrefs, class: className } = Astro.props;
const t = useTranslations(lang);
---

<nav aria-label={t('Idioma')} class:list={['flex items-center', className]}>
  <ul class="label flex items-center gap-1">
    {
      locales.map((locale, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && (
            <span class="text-rule" aria-hidden="true">
              /
            </span>
          )}
          <a
            href={hrefs[locale]}
            hreflang={locale}
            lang={locale}
            aria-current={locale === lang ? 'true' : undefined}
            class:list={[
              'rounded px-1 py-0.5 transition-colors',
              locale === lang ? 'text-ink' : 'text-faint hover:text-accent',
            ]}
          >
            <span class="sr-only">{localeNames[locale]}</span>
            <span aria-hidden="true">{locale}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
