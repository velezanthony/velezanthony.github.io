---
import type { Variant } from '@/components/variant';

interface Props {
  items: string[];
  /** Optional label rendered before the list, e.g. "Stack". */
  label?: string;
  /** `cv` drops to the document scale's smallest step. */
  size?: Variant;
  /** Label above the list instead of inline — for narrow metadata columns. */
  stacked?: boolean;
  /** The row IS the value of a labelled field, as in the case study's sidebar. It then takes the
      ink of every other value there and the mono list size that matches their weight; left as
      metadata, small and faint like the label above it, it read as a second label. */
  field?: boolean;
  class?: string;
}

const {
  items,
  label,
  size = 'site',
  stacked = false,
  field = false,
  class: className,
} = Astro.props;

const sizes = {
  site: 'text-xs leading-relaxed',
  cv: 'text-cv-micro',
} as const;
---

{items.length > 0 && (
  <p
    class:list={[
      'font-mono',
      field ? 'text-mono-list text-ink' : ['text-faint', sizes[size]],
      className,
    ]}
  >
    {label && stacked && <span class="label mb-1.5 block text-faint">{label}</span>}
    {label && !stacked && <span class="mr-1.5 font-medium text-muted">{label}</span>}
    {items.map((item, index) => (
      <>
        {/* One break point per item, always after the separator: margins
              alone gave none and the list overflowed; spaces on both sides
              gave one too many and lines started with a stray middot. */}
        {index > 0 && ' '}
        {item}
        {index < items.length - 1 && (
          <span class="text-rule" aria-hidden="true">
            {' ·'}
          </span>
        )}
      </>
    ))}
  </p>
)}
