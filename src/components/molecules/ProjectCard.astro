---
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import type { CollectionEntry } from 'astro:content';
import Heading from '@velezanthony/design/components/atoms/display/Heading.astro';
import Text from '@velezanthony/design/components/atoms/display/Text.astro';
import StackRow from '@molecules/StackRow.astro';
import StatusChip from '@molecules/StatusChip.astro';
import DownloadCount from '@molecules/DownloadCount.astro';
import type { DownloadSources, StoreCounts } from '@data/downloads';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';
import type { ProjectStatus } from '@/schemas/project';
import { codeThemes } from '@velezanthony/design/code-themes';

interface Props {
  name: string;
  tagline: string;
  status: ProjectStatus;
  /** The stores the project is published to; the count is read from them in the browser. */
  downloads?: DownloadSources;
  /** What the build read from those stores: shown until the browser refreshes it. */
  downloadCounts?: StoreCounts;
  href: string;
  stack?: string[];
  /** What it is built FOR, as opposed to what it is built with. */
  targets?: string[];
  lang: Locale;
  /** A screenshot, or code where there is no interface to show. */
  visual: CollectionEntry<'projects'>['data']['visual'];
  /** Set by the caller so the document outline never skips a level. */
  headingLevel?: 2 | 3;
}

const {
  name,
  tagline,
  status,
  downloads,
  downloadCounts = {},
  href,
  stack = [],
  targets = [],
  lang,
  visual,
  headingLevel = 3,
} = Astro.props;

const t = useTranslations(lang);
---

<article class="group relative border-t border-rule py-6">
  <div class="card-grid grid gap-x-14 gap-y-3 grid-cols-1 md:grid-cols-[minmax(0,1fr)_var(--container-aside)]">
    <div class="card-main">
      <Heading level={headingLevel} size="md" class="font-mono tracking-tight">
        <a
          href={href}
          class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
        >
          {name}
        </a>
      </Heading>

      <Text size="row" class="mt-1.5 max-w-(--container-measure-row) md:max-w-none">
        {tagline}
      </Text>

      <!-- One fixed height for image and code alike, so the rows stay even. -->
      <div class="card-visual mt-4 h-44 overflow-hidden rounded border border-rule transition-[border-color] group-hover:border-accent">
        {visual.kind === 'image' ? (
          <Image
            src={visual.src}
            alt={visual.alt}
            widths={[480, 960, 1712]}
            sizes="(min-width: 1024px) 856px, 100vw"
            loading="lazy"
            class="h-full w-full object-cover"
            style={visual.focus ? `object-position: ${visual.focus}` : undefined}
          />
        ) : (
          <Code code={visual.code} lang={visual.lang as never} themes={codeThemes} wrap={null} />
        )}
      </div>
    </div>

    <div class="card-meta min-w-0 lg:pt-1.5">
      <div class="card-status">
        <StatusChip status={status} lang={lang} />
      </div>
      <DownloadCount sources={downloads} counts={downloadCounts} lang={lang} variant="card" />
      <StackRow items={stack} class="mt-3" />
      <StackRow items={targets} label={t('Para')} stacked class="mt-3" />
    </div>
  </div>
</article>

<style>
  /* Below md the two columns dissolve into the card's own grid, so the status rises beside the
     name instead of falling under the visual; everything else keeps its order, full width. */
  @media (width < 48rem) {
    .card-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1rem;
      row-gap: 0;
    }

    .card-main,
    .card-meta {
      display: contents;
    }

    .card-main > :global(*),
    .card-meta > :global(*) {
      grid-column: 1 / -1;
    }

    /* On the name's first baseline, so a name wrapped to two lines keeps the status on its first. */
    .card-main > :global(:first-child) {
      grid-column: 1;
      order: -2;
      align-self: first baseline;
    }

    .card-status {
      grid-column: 2;
      order: -1;
      align-self: first baseline;
    }
  }

  /* Shiki's block, sized to the frame: the card shows a glimpse, never a scrollbar. */
  .card-visual :global(pre) {
    height: 100%;
    margin: 0;
    padding: 0.875rem 1rem;
    overflow: hidden;
    font-size: var(--text-mono-list);
    line-height: 1.6;
  }
</style>
