---
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  aria-label={t('Cambiar tema')}
  title={t('Cambiar tema')}
>
  <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
  </svg>

  <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 14.4A8.5 8.5 0 0 1 9.6 4a8.5 8.5 0 1 0 10.4 10.4Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    ></path>
  </svg>
</button>

<style>
  /* Tailwind 4's preflight sets `cursor: default` on every button. */
  .theme-toggle {
    cursor: pointer;
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    /* A flex row short of room squeezed it to 19px wide; it is a 32px target. */
    flex-shrink: 0;
    color: var(--color-faint);
    border-radius: 3px;
    transition: color 150ms ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  /* Show the icon of the current theme: sun in light, moon in dark. A choice overrides the
     system's preference both ways, hence the light rules at the end. */
  .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .icon-moon {
      display: block;
    }
  }

  :root[data-theme='dark'] .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .icon-moon {
    display: block;
  }

  :root[data-theme='light'] .icon-sun {
    display: block;
  }
  :root[data-theme='light'] .icon-moon {
    display: none;
  }
</style>

<script>
  import { THEME_KEY, safeSet, storageOf } from '@/client/storage';
  import { isDark, nextTheme, parseTheme, syncThemeColor, syncToggle } from '@/client/theme';
  import { themeColors } from '@styles/theme-colors';

  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const chosen = () => parseTheme(root.dataset.theme);
  const buttons = document.querySelectorAll('.theme-toggle');

  const sync = () => {
    for (const button of buttons) syncToggle(button, isDark(chosen(), system.matches));
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const next = nextTheme(chosen(), system.matches);
      root.dataset.theme = next;
      syncThemeColor(document, themeColors[next]);
      safeSet(storageOf('localStorage'), THEME_KEY, next);
      sync();
    });
  }

  /* With no explicit choice the page follows the system, and so must the pressed state. */
  system.addEventListener('change', sync);
  sync();
</script>
