---
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';

/** Marks a stretch of the timeline spent studying. The detail lives in the education section. */
interface Props {
  lang: Locale;
  variant?: 'site' | 'cv';
}

const { lang, variant = 'site' } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['flex items-center gap-3', variant === 'cv' ? 'py-1.5' : 'py-3']}>
  <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
  <span class="label shrink-0 text-faint">{t('Formación')}</span>
  <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
</div>
