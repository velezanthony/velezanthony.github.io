---
/** Marks a stretch of the timeline spent studying. It names which one and when, because two
    unlabelled rules read as a rendering fault; the full title lives in the education section. */
import type { Study } from '@data/types';

interface Props {
  study: Study;
  variant?: 'site' | 'cv';
}

const { study, variant = 'site' } = Astro.props;
---

<div class:list={['flex items-center gap-3', variant === 'cv' ? 'py-1.5' : 'py-3']}>
  <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
  <span class="label shrink-0 text-faint tabular-nums">
    {study.abbr} · {study.startYear} – {study.endYear}
  </span>
  <span class="h-px flex-1 bg-rule" aria-hidden="true"></span>
</div>
