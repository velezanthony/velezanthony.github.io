---
import { Font } from 'astro:assets';
import { PUBLIC_GTM_ID } from 'astro:env/client';
import '@styles/theme.css';
import { profile } from '@data/profile';
import { alternateLocale, useTranslations } from '@i18n/utils';
import { locales, ogLocales } from '@i18n/ui';
import type { Locale } from '@i18n/ui';
import { person } from '@/seo/jsonld';
import { THEME_KEY } from '@/client/storage';
import RememberLocale from '@atoms/RememberLocale.astro';
import { themeColors } from '@styles/theme-colors';

interface Props {
  lang: Locale;
  title: string;

  /** Skips the ` | Anthony Velez Tapia` suffix. Project pages carry their own
      two-part title and would otherwise overflow the SERP truncation point. */
  bareTitle?: boolean;
  description: string;
  /** Every locale's URL for this page, for `hreflang`. */
  alternates: Record<Locale, string>;
  /** Keeps a page out of search results — used by 404. */
  noindex?: boolean;
  bodyClass?: string;
}

const {
  lang,
  title,
  bareTitle = false,
  description,
  alternates,
  noindex = false,
  bodyClass,
} = Astro.props;
const t = useTranslations(lang);

const fullTitle = bareTitle || title === profile.name ? title : `${title} | ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {PUBLIC_GTM_ID && (
      <script
        is:inline
        set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','${PUBLIC_GTM_ID}');`}
      />
    )}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    {!noindex && <link rel="canonical" href={canonical.href} />}
    {!noindex &&
      locales.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(alternates[locale], Astro.site).href}
        />
      ))}
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site).href} />
    )}

    {/* Absolute URL required: crawlers do not resolve relative image paths. */}
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={profile.name} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:locale:alternate" content={ogLocales[alternateLocale(lang)]} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(person(lang, canonical.href))}
    />
    <script is:inline define:vars={{ key: THEME_KEY }}>
      /* Runs before first paint: without it the page renders in the system
         theme and then flips, which is the flash every toggle has to avoid.
         Inline, so it cannot import. */
      try {
        const saved = localStorage.getItem(key);
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        /* Storage blocked: the system theme stands. */
      }
    </script>

    <slot name="head" />
  </head>

  {
    /* Not on the 404 itself: served at arbitrary paths, it would read as Spanish and overwrite
       the value it is about to consume. */
    !noindex && <RememberLocale />
  }

  <body class:list={['min-h-screen bg-canvas antialiased', bodyClass]}>
    {
      /* Ahead of the skip link on Google's instruction. It costs nothing there:
         hidden and non-focusable, it never lands in the tab order. */
      PUBLIC_GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${encodeURIComponent(PUBLIC_GTM_ID)}`}
            title="Google Tag Manager"
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }

    <a
      href="#main"
      class="label sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:border focus:border-rule focus:bg-canvas focus:px-3 focus:py-2 focus:text-ink"
    >
      {t('Ir al contenido')}
    </a>

    <slot />
  </body>
</html>
