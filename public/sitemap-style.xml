<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <xsl:output method="html" encoding="UTF-8" doctype-system="about:legacy-compat" />

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, follow" />
        <title>Sitemap — Anthony Velez Tapia</title>
        <style>
          :root {
            --canvas: #fbfcfc; --raised: #f5f7f7; --ink: #111827;
            --muted: #4b5563; --faint: #6b7280; --accent: #00635b; --rule: #d5dada;
          }
          @media (prefers-color-scheme: dark) {
            :root {
              --canvas: #0e1111; --raised: #161a1a; --ink: #e0e8e8;
              --muted: #a6b0b0; --faint: #7e8988; --accent: #67bdb1; --rule: #2d3333;
            }
          }
          body {
            max-width: 62rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem;
            background: var(--canvas); color: var(--ink); font-size: 15px; line-height: 1.5;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
          }
          h1 { margin: 0 0 .25rem; font-size: 1.5rem; letter-spacing: -.01em; }
          p { margin: 0 0 .5rem; color: var(--muted); }
          .count {
            display: inline-block; margin-bottom: 2rem; padding: .15rem .5rem;
            border: 1px solid var(--rule); border-radius: 999px;
            background: var(--raised); color: var(--faint); font-size: .8rem;
          }
          .scroll { overflow-x: auto; }
          table { width: 100%; border-collapse: collapse; font-size: .9rem; }
          th {
            padding: 0 0 .5rem; border-bottom: 2px solid var(--ink); color: var(--faint);
            font-size: .72rem; letter-spacing: .08em; text-align: left; text-transform: uppercase;
          }
          td { padding: .6rem 0; border-bottom: 1px solid var(--rule); vertical-align: baseline; }
          th + th, td + td { padding-left: 1.5rem; }
          tbody tr:hover td { background: var(--raised); }
          a { color: var(--accent); text-decoration: none; }
          a:hover { text-decoration: underline; }
          .num, .when, .alt { width: 1%; white-space: nowrap; }
          .num, .when { color: var(--faint); font-variant-numeric: tabular-nums; }
          .when { color: var(--muted); }
          .tag {
            display: inline-block; margin: 0 .25rem .25rem 0; padding: .05rem .4rem;
            border: 1px solid var(--rule); border-radius: 4px; background: var(--raised);
            color: var(--muted); font-family: ui-monospace, Menlo, monospace; font-size: .72rem;
          }
          footer { margin-top: 2.5rem; color: var(--faint); font-size: .8rem; }
          @media (max-width: 40rem) {
            th + th, td + td { padding-left: .75rem; }
            table { font-size: .82rem; }
          }
        </style>
      </head>
      <body>
        <xsl:apply-templates />
        <footer>Generated by Astro. Crawlers read the XML; this view is for people.</footer>
      </body>
    </html>
  </xsl:template>

  <xsl:template name="when">
    <td class="when">
      <xsl:choose>
        <xsl:when test="s:lastmod"><xsl:value-of select="substring(s:lastmod, 1, 10)" /></xsl:when>
        <xsl:otherwise>—</xsl:otherwise>
      </xsl:choose>
    </td>
  </xsl:template>

  <xsl:template match="s:sitemapindex">
    <h1>Sitemap index</h1>
    <p>Each entry below is a sitemap of its own.</p>
    <p class="count"><xsl:value-of select="count(s:sitemap)" /> sitemaps</p>
    <div class="scroll">
      <table>
        <tr><th class="num">#</th><th>Sitemap</th><th class="when">Last modified</th></tr>
        <xsl:for-each select="s:sitemap">
          <tr>
            <td class="num"><xsl:value-of select="position()" /></td>
            <td><a href="{s:loc}"><xsl:value-of select="s:loc" /></a></td>
            <xsl:call-template name="when" />
          </tr>
        </xsl:for-each>
      </table>
    </div>
  </xsl:template>

  <xsl:template match="s:urlset">
    <h1>Sitemap</h1>
    <p>Every page offered to search engines, with its translations.</p>
    <p class="count"><xsl:value-of select="count(s:url)" /> URLs</p>
    <div class="scroll">
      <table>
        <tr><th class="num">#</th><th>URL</th><th class="alt">Alternates</th><th class="when">Last modified</th></tr>
        <xsl:for-each select="s:url">
          <tr>
            <td class="num"><xsl:value-of select="position()" /></td>
            <td><a href="{s:loc}"><xsl:value-of select="s:loc" /></a></td>
            <td class="alt">
              <xsl:for-each select="xhtml:link">
                <a class="tag" href="{@href}"><xsl:value-of select="@hreflang" /></a>
              </xsl:for-each>
            </td>
            <xsl:call-template name="when" />
          </tr>
        </xsl:for-each>
      </table>
    </div>
  </xsl:template>
</xsl:stylesheet>
