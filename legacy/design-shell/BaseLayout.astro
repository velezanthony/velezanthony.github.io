---
import { Font } from 'astro:assets';
import Shell from '@velezanthony/design/components/layouts/Shell.astro';
import ConsentBanner from '@velezanthony/design/components/organisms/privacy/ConsentBanner.astro';
import { path, useTranslations } from '@i18n/utils';
import type { Locale } from '@i18n/ui';
import { designStrings, gtmId } from '@/design/site-config';
import { pageHead } from '@/seo/head';
import RememberLocale from '@atoms/RememberLocale.astro';

interface Props {
  lang: Locale;
  title: string;

  /** Skips the ` | Anthony Velez Tapia` suffix. Project pages carry their own
      two-part title and would otherwise overflow the SERP truncation point. */
  bareTitle?: boolean;
  description: string;
  /** Every locale's URL for this page, for `hreflang`. */
  alternates: Record<Locale, string>;
  /** Keeps a page out of search results — used by 404. */
  noindex?: boolean;
}

const { lang, title, bareTitle = false, description, alternates, noindex = false } = Astro.props;
const t = useTranslations(lang);

const head = pageHead({
  lang,
  title,
  bareTitle,
  description,
  alternates,
  noindex,
  pathname: Astro.url.pathname,
  site: Astro.site!,
  generator: Astro.generator,
});
---

<Shell lang={lang} head={head}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />

    <slot name="head" />
  </Fragment>

  {
    /* Not on the 404 itself: served at arbitrary paths, it would read as Spanish and overwrite
       the value it is about to consume. */
    !noindex && <RememberLocale />
  }

  <a
    href="#main"
    class="label sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:border focus:border-rule focus:bg-canvas focus:px-3 focus:py-2 focus:text-ink"
  >
    {t('Ir al contenido')}
  </a>

  <slot />

  {
    /* Tag Manager is not in the page: the banner's script loads it, and only for a visitor who
       accepted. It is the only way in, so with no ID there is nothing to ask about. */
    gtmId && (
      <ConsentBanner
        gtmId={gtmId}
        privacyUrl={path(lang, 'privacy')}
        strings={designStrings(lang)}
      />
    )
  }
</Shell>

<script>
  import { bootDocs } from '@velezanthony/design/components/layouts/boot.ts';

  /* The library's client wiring: it reads the page for what it finds (the consent banner, the
     theme toggle) and ignores the rest. Its modules are not exported; this one is. */
  bootDocs();
</script>
