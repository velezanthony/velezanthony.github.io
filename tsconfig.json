{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@data/*": ["src/data/*"],
      "@adapters/*": ["src/adapters/*"],
      "@client/*": ["src/client/*"],
      "@ui/*": ["src/ui/*"]
    }
  }
}
